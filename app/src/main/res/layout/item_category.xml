<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingVertical="@dimen/space_sm">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_category_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="Food" />

        <TextView
            android:id="@+id/badge_over"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_badge_over"
            android:paddingHorizontal="@dimen/chip_padding_horizontal"
            android:paddingVertical="@dimen/chip_padding_vertical"
            android:text="@string/category_status_over"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/on_status_over_container"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Takes the remaining width, right-aligned, with a guaranteed gap from the name/pill.
             With two-decimal amounts and large fonts it wraps to two lines instead of colliding. -->
        <TextView
            android:id="@+id/text_category_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:gravity="end"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="₱4,293.00 of ₱4,000.00" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_category_planned"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:fontFamily="monospace"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="Planned ₱2,400.00"
        tools:visibility="visible" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:importantForAccessibility="no"
        android:progress="40"
        app:trackCornerRadius="4dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

</LinearLayout>
