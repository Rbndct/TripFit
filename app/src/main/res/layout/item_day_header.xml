<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/space_md"
    android:paddingTop="@dimen/space_lg"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/text_day_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnBackground"
        tools:text="Day 1" />

    <TextView
        android:id="@+id/text_stops_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_count"
        android:paddingHorizontal="@dimen/chip_padding_horizontal"
        android:paddingVertical="@dimen/chip_padding_vertical"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        android:textColor="?attr/colorOnPrimaryContainer"
        tools:text="3 stops" />

</LinearLayout>
